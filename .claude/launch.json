{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "adk-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "adk",
        "web",
        "--port",
        "9000"
      ],
      "port": 9000
    },
    {
      "name": "admin-ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "ui.app:app",
        "--port",
        "9100"
      ],
      "port": 9100
    },
    {
      "name": "site",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "main:app",
        "--port",
        "8080"
      ],
      "port": 8080
    }
  ]
}