# ローカルで動かすときの設定の見本。このファイルを `.env` にコピーして、自分の値を入れる。
# `.env` は Git に入れない（.gitignore と .gcloudignore で除外済み）。パスワードやキーは、ここにも書かない。

# 使う Google Cloud プロジェクトの ID
GOOGLE_CLOUD_PROJECT=your-project-id
# gemini-3.x は global のみ
GOOGLE_CLOUD_LOCATION=global
# Vertex AI 経由で Gemini を使う
GOOGLE_GENAI_USE_VERTEXAI=true

# --- 任意 ---
# 判定の基準日を固定する（デモ・テスト用。未設定なら日本時間の今日）
# DEMO_TODAY=2026-10-15
# キャッシュの保存期間（既定: 7日 / 「見つからなかった」の記録は 6時間）
# CACHE_TTL_DAYS=7
# NEGATIVE_TTL_HOURS=6
# 本番の入口（main.py）の Basic 認証。未設定なら全アクセスを拒否する
# APP_USER=
# APP_PASSWORD=
